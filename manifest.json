{
  "schemaVersion": 1,
  "id": "b.omadoro",
  "name": "Omadoro",
  "version": "0.1.0",
  "author": "Brian Blakely",
  "license": "MIT",
  "description": "A Pomodoro timer for the Omarchy bar.",
  "kinds": ["service", "bar-widget"],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omadoro",
    "description": "A circular Pomodoro timer with keyboard-driven controls.",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "workMinutes": 25,
      "shortBreakMinutes": 5,
      "longBreakMinutes": 15,
      "workPhasesPerLongBreak": 4,
      "soundEnabled": true,
      "soundName": "complete",
      "flashScreenMode": "off",
      "flashBarEnabled": true,
      "flashBorderEnabled": true,
      "flashCount": 3,
      "flashSpeed": "normal"
    },
    "schema": [
      {
        "key": "workMinutes",
        "type": "integer",
        "label": "Work duration (minutes)",
        "min": 1,
        "max": 120,
        "step": 1,
        "defaultValue": 25
      },
      {
        "key": "shortBreakMinutes",
        "type": "integer",
        "label": "Short break (minutes)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "longBreakMinutes",
        "type": "integer",
        "label": "Long break (minutes)",
        "min": 1,
        "max": 120,
        "step": 1,
        "defaultValue": 15
      },
      {
        "key": "workPhasesPerLongBreak",
        "type": "integer",
        "label": "Work phases before long break",
        "min": 1,
        "max": 12,
        "step": 1,
        "defaultValue": 4
      },
      {
        "key": "soundEnabled",
        "type": "boolean",
        "label": "Play a sound when a phase starts",
        "defaultValue": true
      },
      {
        "key": "soundName",
        "type": "string",
        "label": "Alert sound",
        "defaultValue": "complete"
      },
      {
        "key": "flashScreenMode",
        "type": "string",
        "label": "Screen invert",
        "description": "Off, background wallpaper only, or the whole screen including windows.",
        "defaultValue": "off"
      },
      {
        "key": "flashBarEnabled",
        "type": "boolean",
        "label": "Flash the bar",
        "description": "Invert the status bar when a phase starts.",
        "defaultValue": true
      },
      {
        "key": "flashBorderEnabled",
        "type": "boolean",
        "label": "Flash the border",
        "description": "Draw a 5px frame around the monitor when a phase starts.",
        "defaultValue": true
      },
      {
        "key": "flashCount",
        "type": "integer",
        "label": "Flash count",
        "min": 1,
        "max": 8,
        "step": 1,
        "defaultValue": 3
      },
      {
        "key": "flashSpeed",
        "type": "string",
        "label": "Flash speed",
        "defaultValue": "normal"
      }
    ]
  }
}
